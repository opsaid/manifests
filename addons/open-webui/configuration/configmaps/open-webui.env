# ---- 基础 ----
ENV=prod
WEBUI_URL=http://open-webui.example.com
# 使用 env 管理运行配置；数据持久化边界见 docs/apps/open-webui.md
ENABLE_PERSISTENT_CONFIG=False
ENABLE_ADMIN_CHAT_ACCESS=False
REQUESTS_VERIFY=True
ENABLE_FORWARD_USER_INFO_HEADERS=False
# Kubernetes 负责横向扩容；每个 Pod 仅运行一个 Uvicorn worker。
UVICORN_WORKERS=1
THREAD_POOL_SIZE=2000
# 降低多副本场景下活跃状态写入频率，同时保持在 180 秒活跃窗口内。
DATABASE_USER_ACTIVE_STATUS_UPDATE_INTERVAL=120
# 单副本安装/升级时由唯一 Pod 执行迁移；扩容前须先完成迁移，再覆盖为 False。
ENABLE_DB_MIGRATIONS=True

# ---- 模型接入 ----
ENABLE_OLLAMA_API=False
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ---- RAG / embedding（外部服务，不使用本地模型）----
# 兜底禁止 HuggingFace 本地模型下载（embedding / 转写均走外部）
HF_HUB_OFFLINE=1
RAG_EMBEDDING_ENGINE=openai
# openai 引擎下必须显式指定模型名：默认值是本地 sentence-transformers 模型名
# （sentence-transformers/all-MiniLM-L6-v2），外部引擎调用会报模型不存在
RAG_EMBEDDING_MODEL=text-embedding-3-small

# 生产内容抽取建议使用外部 Tika；接入时在 overlay 中取消注释并填写实际地址。
#CONTENT_EXTRACTION_ENGINE=tika
#TIKA_SERVER_URL=http://tika.example.com:9998

# ---- OAuth / OIDC（默认关闭；启用时提供完整配置）----
ENABLE_LOGIN_FORM=True
ENABLE_OAUTH_SIGNUP=False
OAUTH_AUTO_REDIRECT=False
ENABLE_OAUTH_TOKEN_EXCHANGE=False
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=False
OAUTH_PROVIDER_NAME=OpenID
OAUTH_CLIENT_ID=
OPENID_PROVIDER_URL=
OPENID_REDIRECT_URI=http://open-webui.example.com/oauth/oidc/callback
OAUTH_SCOPES=openid email profile
ENABLE_OAUTH_ROLE_MANAGEMENT=False
ENABLE_OAUTH_GROUP_MANAGEMENT=False
ENABLE_OAUTH_GROUP_CREATION=False

# ---- Redis / websocket（集群内 open-webui-redis）----
# 改 namespace 必须同时覆盖 REDIS_URL，Kustomize 不改写 env 内字符串。
ENABLE_WEBSOCKET_SUPPORT=True
WEBSOCKET_MANAGER=redis
REDIS_URL=redis://redis.open-webui.svc.cluster.local:6379/0
REDIS_SOCKET_KEEPALIVE=True
# 小于 Redis 服务端 1800 秒 idle timeout，复用连接前先做健康检查。
REDIS_HEALTH_CHECK_INTERVAL=60

# ---- 向量库：pgvector 复用 DATABASE_URL 指向的 Postgres ----
VECTOR_DB=pgvector

# ---- S3 对象存储（上传文件，占位待填）----
STORAGE_PROVIDER=s3
# 注意：S3_ENDPOINT_URL / S3_REGION_NAME 留空（空串）会导致应用启动即崩溃（botocore Invalid endpoint），
# 接入时填入实际值后取消注释；使用 AWS 原生桶时不要启用 S3_ENDPOINT_URL
#S3_ENDPOINT_URL=
S3_BUCKET_NAME=CHANGE_ME
#S3_REGION_NAME=
S3_KEY_PREFIX=

# ---- OpenTelemetry（当前关闭，保留接入点）----
ENABLE_OTEL=False
ENABLE_OTEL_TRACES=False
ENABLE_OTEL_METRICS=False
ENABLE_OTEL_LOGS=False
OTEL_EXPORTER_OTLP_ENDPOINT=CHANGE_ME
OTEL_METRICS_EXPORTER_OTLP_ENDPOINT=CHANGE_ME
OTEL_LOGS_EXPORTER_OTLP_ENDPOINT=CHANGE_ME
OTEL_EXPORTER_OTLP_INSECURE=True
OTEL_SERVICE_NAME=open-webui
OTEL_METRICS_EXPORT_INTERVAL_MILLIS=10000
OTEL_TRACES_SAMPLER=always_off
